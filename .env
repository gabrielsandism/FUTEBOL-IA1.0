POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# API Sports
SPORTS_API_KEY=3321eeee21b24ff58d0a46bc86f6d2e0
SPORTS_API_PROVIDER=footballdata

# Application
APP_HOST=127.0.0.1
